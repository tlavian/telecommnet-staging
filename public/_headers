# Staging / preview host (telecommnet.pages.dev and *.telecommnet.pages.dev) must never be indexed.
# ":project" is Cloudflare's placeholder for this project's pages.dev subdomain, so this rule also
# covers preview deployments. Production (telecommnet.com) is not matched by it.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/*
  Link: <https://telecommnet.com/llms.txt>; rel="llmstxt"
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: unsafe-none
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; frame-ancestors 'none';

/
  Cache-Control: public, max-age=3600, s-maxage=86400

# Static assets — long cache with immutable for hashed files
/images/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts — content-stable, immutable long cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Favicons / touch icons — stable filenames
/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Deferred CSS (unhashed filename) — revalidate daily so edits still propagate
/css/deferred.css
  Cache-Control: public, max-age=86400, must-revalidate

# Legacy CV URL — kept for backward compatibility (redirected via _redirects)
/Dr-Tal-Lavian-CV-Expert-Witness-Network-Communications-Telecommunications-Internet-Protocols-Mobile-Wireless.pdf
  Cache-Control: no-store, no-cache, must-revalidate

# Block all other PDFs from indexing
/*.pdf
  Cache-Control: public, max-age=604800
  X-Robots-Tag: noindex, nofollow

/files/*
  X-Robots-Tag: noindex, nofollow

# Allow indexing of Dr. Lavian's resume/CV — short cache so updates propagate within 1 hour.
# ORDER MATTERS: Cloudflare Pages combines the headers of EVERY matching rule, so this rule must
# come AFTER the "/*.pdf" catch-all above. The "! Header" lines detach the X-Robots-Tag and
# Cache-Control values already attached by "/*.pdf" (otherwise the CV would be served with both
# "index, follow" and "noindex, nofollow"), and the lines after them re-attach the CV-only values.
/Dr-Tal-Lavian-CV-Expert-Witness-Network-Communications-Telecommunications-Internet-Protocols-Mobile-Wireless-2026.pdf
  ! X-Robots-Tag
  ! Cache-Control
  Cache-Control: public, max-age=3600
  X-Robots-Tag: index, follow

# AI crawler files — short cache so updates propagate quickly
/llms.txt
  Cache-Control: public, max-age=3600

/llms-full.txt
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Cache-Control: public, max-age=3600

# Block legacy WordPress tag pages — cannibalizing real expertise pages
/tag/*
  X-Robots-Tag: noindex, nofollow

# Staging copy of the CV: the CV rule above detaches X-Robots-Tag on every host, which would also
# remove the staging "noindex" set at the top of this file. Re-apply it here (last, so it wins).
https://:project.pages.dev/Dr-Tal-Lavian-CV-Expert-Witness-Network-Communications-Telecommunications-Internet-Protocols-Mobile-Wireless-2026.pdf
  ! X-Robots-Tag
  X-Robots-Tag: noindex

